@model CookingWebsite.Models.CongThuc

@{
    ViewData["Title"] = "Create Recipe";
}

<h2>Tạo Công Thức Mới</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    
    <div class="form-group mb-3">
        <label asp-for="TenCongThuc" class="form-label">Tên Công Thức</label>
        <input asp-for="TenCongThuc" class="form-control" />
        <span asp-validation-for="TenCongThuc" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="MoTa" class="form-label">Mô Tả</label>
        <textarea asp-for="MoTa" class="form-control" rows="5"></textarea>
        <span asp-validation-for="MoTa" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-3">
            <div class="form-group mb-3">
                <label asp-for="ThoiGianChuanBi" class="form-label">Thời Gian Chuẩn Bị (phút)</label>
                <input asp-for="ThoiGianChuanBi" class="form-control" type="number" />
                <span asp-validation-for="ThoiGianChuanBi" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group mb-3">
                <label asp-for="TongThoiGianNau" class="form-label">Thời Gian Nấu (phút)</label>
                <input asp-for="TongThoiGianNau" class="form-control" type="number" />
                <span asp-validation-for="TongThoiGianNau" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group mb-3">
                <label asp-for="PhucVu" class="form-label">Khẩu Phần</label>
                <input asp-for="PhucVu" class="form-control" type="number" />
                <span asp-validation-for="PhucVu" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group mb-3">
                <label asp-for="TacGia" class="form-label">Tác Giả</label>
                <input asp-for="TacGia" class="form-control" />
                <span asp-validation-for="TacGia" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="form-group mb-3">
        <label class="form-label">Ảnh Đại Diện</label>
        <input type="file" name="anh" class="form-control" accept="image/*" />
    </div>

    <div class="form-group mb-3">
        <label class="form-label">Ảnh Chi Tiết</label>
        <input type="file" name="anhChiTiet" class="form-control" accept="image/*" />
    </div>

    <div class="form-group mb-3">
        <label class="form-label">Danh Mục</label>
        <div class="row">
            @foreach (var category in ViewBag.LoaiMonAns as List<CookingWebsite.Models.LoaiMonAn>)
            {
                <div class="col-md-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="selectedCategories" value="@category.MaLoaiMonAn" id="cat_@category.MaLoaiMonAn">
                        <label class="form-check-label" for="cat_@category.MaLoaiMonAn">
                            @category.TenLoaiMonAn
                        </label>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="form-group">
        <button type="submit" class="btn btn-primary">Tạo Mới</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}



