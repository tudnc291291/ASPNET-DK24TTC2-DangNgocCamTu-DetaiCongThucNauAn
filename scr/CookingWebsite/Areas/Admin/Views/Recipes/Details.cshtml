@model CookingWebsite.Models.CongThuc

@{
    ViewData["Title"] = "Recipe Details";
}

<div class="container mt-4">
    <h2>Chi Tiết Công Thức</h2>
    
    <div>
        <dl class="row">
            <dt class="col-sm-2">ID</dt>
            <dd class="col-sm-10">@Model.MaCongThuc</dd>
            
            <dt class="col-sm-2">Tên</dt>
            <dd class="col-sm-10">@Model.TenCongThuc</dd>
            
            <dt class="col-sm-2">Mô tả</dt>
            <dd class="col-sm-10">@Model.MoTa</dd>
            
            <dt class="col-sm-2">Thời gian chuẩn bị</dt>
            <dd class="col-sm-10">@(Model.ThoiGianChuanBi?.ToString() ?? "N/A") phút</dd>
            
            <dt class="col-sm-2">Thời gian nấu</dt>
            <dd class="col-sm-10">@(Model.TongThoiGianNau?.ToString() ?? "N/A") phút</dd>
            
            <dt class="col-sm-2">Khẩu phần</dt>
            <dd class="col-sm-10">@(Model.PhucVu?.ToString() ?? "N/A")</dd>
            
            <dt class="col-sm-2">Tác giả</dt>
            <dd class="col-sm-10">@Model.TacGia</dd>
        </dl>
    </div>
    
    <div>
        <a asp-action="Edit" asp-route-id="@Model.MaCongThuc" class="btn btn-warning">Sửa</a>
        <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
    </div>
</div>



