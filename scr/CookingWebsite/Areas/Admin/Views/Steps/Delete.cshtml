@model CookingWebsite.Models.CacBuocNau

@{
    ViewData["Title"] = "Delete Cooking Step";
}

<h2>Xóa Bước Thực Hiện</h2>

<h3>Bạn có chắc chắn muốn xóa bước này?</h3>
<div>
    <h4>Bước @Model.BuocThucHien</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Hướng dẫn</dt>
        <dd class="col-sm-10">@Model.HuongDan</dd>
        <dt class="col-sm-2">Công thức</dt>
        <dd class="col-sm-10">@Model.CongThuc?.TenCongThuc</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="MaBuoc" />
        <button type="submit" class="btn btn-danger">Xóa</button>
        <a asp-action="ByRecipe" asp-route-recipeId="@Model.MaCongThuc" class="btn btn-secondary">Hủy</a>
    </form>
</div>



