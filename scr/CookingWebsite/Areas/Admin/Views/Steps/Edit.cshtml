@model CookingWebsite.Models.CacBuocNau

@{
    ViewData["Title"] = "Edit Cooking Step";
}

<h2>Sửa Bước Thực Hiện</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="MaBuoc" />
    <input type="hidden" asp-for="MaCongThuc" />
    
    <div class="form-group mb-3">
        <label asp-for="BuocThucHien" class="form-label">Bước Số</label>
        <input asp-for="BuocThucHien" class="form-control" type="number" />
        <span asp-validation-for="BuocThucHien" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="HuongDan" class="form-label">Hướng Dẫn</label>
        <textarea asp-for="HuongDan" class="form-control" rows="5"></textarea>
        <span asp-validation-for="HuongDan" class="text-danger"></span>
    </div>

    <div class="form-group">
        <button type="submit" class="btn btn-primary">Lưu</button>
        <a asp-action="ByRecipe" asp-route-recipeId="@Model.MaCongThuc" class="btn btn-secondary">Hủy</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}



