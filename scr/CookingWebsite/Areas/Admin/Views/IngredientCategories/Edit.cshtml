@model CookingWebsite.Models.LoaiNguyenLieu

@{
    ViewData["Title"] = "Edit Ingredient Category";
}

<h2>Sửa Danh Mục Nguyên Liệu</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="MaLoaiNguyenLieu" />
    
    <div class="form-group mb-3">
        <label asp-for="TenLoai" class="form-label">Tên Danh Mục</label>
        <input asp-for="TenLoai" class="form-control" />
        <span asp-validation-for="TenLoai" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="MoTa" class="form-label">Mô Tả</label>
        <textarea asp-for="MoTa" class="form-control" rows="3"></textarea>
        <span asp-validation-for="MoTa" class="text-danger"></span>
    </div>

    <div class="form-group">
        <button type="submit" class="btn btn-primary">Lưu</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}



