@model IEnumerable<CookingWebsite.Models.LoaiNguyenLieu>

@{
    ViewData["Title"] = "Manage Ingredient Categories";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Quản Lý Danh Mục Nguyên Liệu</h2>
        <a asp-action="Create" class="btn btn-primary">Thêm Danh Mục Mới</a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Tên Danh Mục</th>
                <th>Mô Tả</th>
                <th>Hành Động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.MaLoaiNguyenLieu</td>
                    <td>@category.TenLoai</td>
                    <td>@category.MoTa</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@category.MaLoaiNguyenLieu" class="btn btn-sm btn-info">Chi Tiết</a>
                        <a asp-action="Edit" asp-route-id="@category.MaLoaiNguyenLieu" class="btn btn-sm btn-warning">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@category.MaLoaiNguyenLieu" class="btn btn-sm btn-danger">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>



