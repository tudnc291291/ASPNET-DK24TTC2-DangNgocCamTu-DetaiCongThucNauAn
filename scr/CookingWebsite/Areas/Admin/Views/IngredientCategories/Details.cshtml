@model CookingWebsite.Models.LoaiNguyenLieu

@{
    ViewData["Title"] = "Category Details";
}

<div class="container mt-4">
    <h2>Chi Tiết Danh Mục Nguyên Liệu</h2>
    
    <div>
        <dl class="row">
            <dt class="col-sm-2">ID</dt>
            <dd class="col-sm-10">@Model.MaLoaiNguyenLieu</dd>
            
            <dt class="col-sm-2">Tên Danh Mục</dt>
            <dd class="col-sm-10">@Model.TenLoai</dd>
            
            <dt class="col-sm-2">Mô Tả</dt>
            <dd class="col-sm-10">@Model.MoTa</dd>
            
            <dt class="col-sm-2">Số Lượng Nguyên Liệu</dt>
            <dd class="col-sm-10">@Model.NguyenLieus.Count</dd>
        </dl>
    </div>
    
    <div>
        <h4>Nguyên liệu trong danh mục này:</h4>
        <ul>
            @foreach (var ingredient in Model.NguyenLieus)
            {
                <li>@ingredient.TenNguyenLieu</li>
            }
        </ul>
    </div>
    
    <div>
        <a asp-action="Edit" asp-route-id="@Model.MaLoaiNguyenLieu" class="btn btn-warning">Sửa</a>
        <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
    </div>
</div>



